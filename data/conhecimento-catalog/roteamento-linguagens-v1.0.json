{
  "version": "1.1.0",
  "service": "routeLanguageDiscipline",
  "description": "Roteamento estrutural antes da classificação IA de escopo em Linguagens. Sem heurística de palavras.",
  "inputFields": [
    "disciplinaOriginalId",
    "idioma",
    "numero",
    "origem"
  ],
  "outputSchema": {
    "catalogoMateriaId": "linguagens",
    "disciplinaOriginalId": "portugues|ingles|espanhol|indefinido",
    "allowedAssuntoIds": ["string"],
    "criterio": "metadata|posicao_enem|incerto",
    "confianca": "number 0-1",
    "sinalizadorRevisao": "boolean"
  },
  "rules": [
    "idioma=ingles ou espanhol (enem.dev) → rota ingles/l2_en ou espanhol/l2_es.",
    "Q6–Q45 idioma COMUM → portugues (pt_*).",
    "Q1–5 idioma COMUM → indefinido (sync enem.dev; não inferir idioma por palavras).",
    "Nunca alterar idioma no corpus por contagem de palavras.",
    "Classificação N2: IA + catálogo v1.2 dentro da rota permitida."
  ],
  "examples": [
    {
      "input": { "idioma": "ingles", "numero": 3 },
      "output": {
        "disciplinaOriginalId": "ingles",
        "allowedAssuntoIds": ["l2_en"],
        "criterio": "metadata",
        "confianca": 0.99
      }
    },
    {
      "input": { "idioma": "COMUM", "numero": 22 },
      "output": {
        "disciplinaOriginalId": "portugues",
        "allowedAssuntoIds": ["pt_interp", "pt_lit", "pt_gram", "pt_sem", "pt_art", "pt_tec"],
        "criterio": "posicao_enem",
        "confianca": 0.95
      }
    },
    {
      "input": { "idioma": "COMUM", "numero": 3 },
      "output": {
        "disciplinaOriginalId": "indefinido",
        "allowedAssuntoIds": [],
        "criterio": "incerto",
        "confianca": 0.2
      }
    }
  ]
}
