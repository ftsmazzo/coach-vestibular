generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ErrorType {
  CONCEITO_TEORICO
  CALCULO_BOBEIRA
  INTERPRETACAO_ENUNCIADO
  DUVIDA_CRUCIAL
  CHUTE_TOTAL
  FALTA_TEMPO
}

enum QuestStatus {
  pending
  done
  skipped
}

enum AnamnesisStatus {
  IN_PROGRESS
  COMPLETED
}

enum CicloStatus {
  ATIVO
  FECHADO
}

enum FeedbackTipo {
  BUG
  SUGESTAO
  DUVIDA
}

enum FeedbackStatus {
  NOVO
  EM_ANALISE
  RESOLVIDO
  ARQUIVADO
}

enum ProvaTipo {
  ENEM_OFICIAL
  SIMULADO
  VESTIBULAR
  OUTRO
  LISTA_FIXACAO
}

/// Como o aluno usou esta atividade — define peso na jornada e no plano global
enum ModoUsoRegistro {
  OFICIAL
  TREINO
  REVISAO_PROVA_ANTIGA
}

enum StatusSugestaoClassificacao {
  PENDENTE
  ACEITA
  REJEITADA
}

/// Variante de uma questão no banco — COMUM (6+) ou trilha EN/ES na faixa opcional
enum IdiomaVarianteQuestao {
  COMUM
  INGLES
  ESPANHOL
}

/// Prova com blocos de língua estrangeira na mesma numeração (ENEM, UFMS, UFU…)
enum PoliticaIdiomasProva {
  NENHUMA
  DUPLICATA_EN_ES
}

/// Prova cadastrada pelo admin — banco de questões (uma linha por questão)
model Prova {
  id              String    @id @default(cuid())
  nome            String
  banca           String    @default("ENEM")
  tipo            ProvaTipo @default(SIMULADO)
  ano             Int?
  dia             Int?
  caderno         String?
  descricao       String?
  totalQuestoes   Int
  /// Duplicata inglês/espanhol na mesma numeração (ex.: questões 1–5)
  politicaIdiomas     PoliticaIdiomasProva @default(NENHUMA)
  idiomaQuestaoInicio Int?
  idiomaQuestaoFim    Int?
  publicada       Boolean   @default(false)
  gabaritoCompleto Boolean  @default(false)
  /// Texto completo da última extração (PDF/cola) — para auditoria sem reenviar arquivo
  textoFonte       String?   @db.Text
  /// Caderno (PDF/imagem) disponível para o aluno baixar e fazer a prova
  cadernoStoragePath String?
  cadernoFileName    String?
  cadernoMimeType    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questoes ProvaQuestao[]
  tentativas  Exam[]
  studyPlans  StudyPlan[]
}

/// Uma questão da prova — classificação pedagógica (metadados da prova ficam em Prova)
model ProvaQuestao {
  id                  String  @id @default(cuid())
  provaId             String
  numero              Int
  idiomaVariante      IdiomaVarianteQuestao @default(COMUM)
  areaBloco           String?
  materia             String
  assunto             String
  conhecimentoExigido String?
  nivelDificuldade    String?
  observacoes         String?
  /// Trecho do enunciado (IA ou texto colado) — apoia auditoria de classificação
  enunciado           String?   @db.Text
  gabarito            String?

  prova     Prova              @relation(fields: [provaId], references: [id], onDelete: Cascade)
  tentativas QuestionAttempt[]
  sugestoes  SugestaoClassificacao[]

  @@unique([provaId, numero, idiomaVariante])
  @@index([provaId, materia])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            UserRole @default(STUDENT)
  vestibularAlvo       String?  @default("Medicina")
  metaProva            String?
  /** Contato (futuro: notificações WhatsApp) */
  telefone             String?
  /** Nome no ranking — escolhido pelo aluno; se vazio, gera apelido automático */
  nomeExibicaoRanking  String?
  xp                   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exams                    Exam[]
  sugestoesClassificacao   SugestaoClassificacao[]
  diagnosticSnapshots DiagnosticSnapshot[]
  studyPlans          StudyPlan[]
  quests              Quest[]
  emotionalLogs       EmotionalLog[]
  xpEvents            UserXpEvent[]
  uploadJobs          UploadJob[]
  anamnesis           StudentAnamnesis?
  feedbacks           Feedback[]
  ciclos              LearningCycle[]
}

/// Report de erro / sugestão do aluno (beta). Fonte da verdade; também enviado a um webhook (N8N).
model Feedback {
  id            String         @id @default(cuid())
  userId        String
  tipo          FeedbackTipo   @default(BUG)
  status        FeedbackStatus @default(NOVO)
  titulo        String
  descricao     String         @db.Text
  /// Para bug: o que o aluno esperava que acontecesse
  esperado      String?        @db.Text
  severidade    String?
  /// Página/rota onde ocorreu (preenchida ou automática)
  pagina        String?
  /// Contexto técnico automático (url, userAgent, viewport, versão, etc.)
  contextoJson  String?        @db.Text
  /// Anexo opcional (print do erro)
  anexoPath     String?
  anexoFileName String?
  anexoMimeType String?
  /// Nota interna do admin ao tratar
  notaAdmin     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tipo])
}

/// Anamnese inicial — entrevista guiada única (não chat aberto)
model StudentAnamnesis {
  id                   String          @id @default(cuid())
  userId               String          @unique
  status               AnamnesisStatus @default(IN_PROGRESS)
  currentStage         String          @default("trajetoria")
  /// Sessão curta (últimas trocas) — não é histórico infinito
  sessionJson          String?         @db.Text
  /// Perfil estruturado para o motor (inferências, não texto bruto)
  structuredProfileJson String?        @db.Text
  summary              String?         @db.Text
  completedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registro de XP concedido (evita duplicar bônus pela mesma ação)
model UserXpEvent {
  id         String   @id @default(cuid())
  userId     String
  tipo       String
  referencia String
  pontos     Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo, referencia])
  @@index([userId, createdAt])
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  maxUses   Int      @default(5)
  usedCount Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Tentativa do aluno vinculada a uma Prova cadastrada (ou avulsa legado)
model Exam {
  id             String   @id @default(cuid())
  userId         String
  provaId        String?
  nome           String
  data           DateTime
  banca          String?  @default("ENEM")
  totalQuestoes  Int
  nota           Float?
  checkInScore   Int?
  recoveryMode   Boolean          @default(false)
  modoUso        ModoUsoRegistro  @default(OFICIAL)
  /// Trilha EN ou ES nas questões de idioma opcional (1–5 etc.)
  idiomaEstrangeiro IdiomaVarianteQuestao?
  createdAt      DateTime         @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prova              Prova?              @relation(fields: [provaId], references: [id], onDelete: SetNull)
  questionAttempts   QuestionAttempt[]
  diagnosticSnapshot DiagnosticSnapshot?
  emotionalLog       EmotionalLog?
  sugestoesClassificacao SugestaoClassificacao[]
}

/// Aluno sinaliza classificação errada — revisão colaborativa (+ XP se aceita)
model SugestaoClassificacao {
  id                String                      @id @default(cuid())
  userId            String
  examId            String
  provaQuestaoId    String?
  numero            Int
  materiaAtual      String
  assuntoAtual      String
  areaBlocoAtual    String?
  texto             String                      @db.Text
  materiaSugerida   String?
  assuntoSugerido   String?
  areaBlocoSugerida String?
  status            StatusSugestaoClassificacao @default(PENDENTE)
  xpConcedido       Int                         @default(0)
  respostaAdmin     String?                     @db.Text
  createdAt         DateTime                    @default(now())
  reviewedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  provaQuestao ProvaQuestao? @relation(fields: [provaQuestaoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([examId])
}

model QuestionAttempt {
  id             String     @id @default(cuid())
  examId         String
  provaQuestaoId String?
  numero         Int
  correto        Boolean
  respostaAluno  String?
  materiaId      String?
  temaId         String?
  tipoErro       ErrorType?
  observacao     String?    @db.Text
  materiaCorrigida String?
  assuntoCorrigido String?

  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  provaQuestao ProvaQuestao? @relation(fields: [provaQuestaoId], references: [id], onDelete: SetNull)

  @@unique([examId, numero])
}

model DiagnosticSnapshot {
  id              String   @id @default(cuid())
  userId          String
  examId          String   @unique
  scoresJson      String
  focosJson       String
  mensagem        String
  recoveryMode    Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id           String   @id @default(cuid())
  userId       String
  provaId      String?
  /** GLOBAL = plano da semana; PROVA = micro-plano de uma prova do catálogo */
  escopo       String   @default("GLOBAL")
  weekStart    DateTime
  itemsJson    String
  /** Narrativa personalizada (IA) para Home/Plano — gerada na regeneração, não no render */
  narrativeJson String? @db.Text
  /** Como o conteúdo foi gerado: "ia" ou "template" */
  fonteGeracao  String? @default("template")
  recoveryMode Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prova Prova? @relation(fields: [provaId], references: [id], onDelete: SetNull)
}

model Quest {
  id          String      @id @default(cuid())
  userId      String
  cicloId     String?
  titulo      String
  descricao   String?
  materiaId   String?
  temaId      String?
  duracaoMin  Int         @default(30)
  status      QuestStatus @default(pending)
  rewardMsg   String?
  dueDate     DateTime?
  completedAt DateTime?
  moodAfter   Int?
  createdAt   DateTime    @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciclo LearningCycle? @relation(fields: [cicloId], references: [id], onDelete: SetNull)

  @@index([cicloId])
}

/// Ciclo de aprendizagem (semana): meta mensurável, prazo, baseline e resultado.
model LearningCycle {
  id            String      @id @default(cuid())
  userId        String
  indice        Int         @default(1)
  status        CicloStatus @default(ATIVO)
  startAt       DateTime    @default(now())
  endAt         DateTime
  metaClusterId String?
  metaMateria   String?
  metaTitulo    String
  /// Snapshot do alvo no início (pct/erros do cluster e matéria)
  baselineJson  String?     @db.Text
  /// Resultado no fechamento (mini-quiz, antes x depois)
  resultadoJson String?     @db.Text
  fechadoEm     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests  Quest[]
  quizzes CicloQuiz[]

  @@index([userId, status])
}

/// Mini-quiz dirigido de fechamento do ciclo (questões do banco no padrão-alvo).
model CicloQuiz {
  id            String    @id @default(cuid())
  cicloId       String
  clusterAlvo   String?
  materiaAlvo   String?
  /// Questões sorteadas (provaQuestaoId, numero, materia, gabarito...)
  itemsJson     String    @db.Text
  /// Respostas do aluno por questão
  respostasJson String?   @db.Text
  totalQuestoes Int       @default(0)
  pctAcerto     Int?
  status        String    @default("EM_ABERTO")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  ciclo LearningCycle @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@index([cicloId])
}

model EmotionalLog {
  id        String   @id @default(cuid())
  userId    String
  examId    String?  @unique
  score     Int
  nota      String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam? @relation(fields: [examId], references: [id], onDelete: SetNull)
}

model UploadJob {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  status      String   @default("pending")
  /** Caminho relativo em UPLOAD_STORAGE_DIR (ex.: solicitacoes/{id}/arquivo.pdf) */
  storagePath String?
  resultJson  String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
