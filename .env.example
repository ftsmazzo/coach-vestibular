# =============================================================================
# Coach Vestibular — variáveis de ambiente
# Copie para .env (local) ou cole no EasyPanel → App → Environment
# =============================================================================

# --- Obrigatórias ---

# PostgreSQL (EasyPanel: use a URL interna do serviço Postgres)
# Formato: postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL="postgresql://coach:SUA_SENHA_AQUI@NOME_SERVICO_POSTGRES:5432/coach_vestibular"

# Segredo para JWT de sessão (mín. 32 caracteres aleatórios)
JWT_SECRET="gere-uma-string-longa-e-aleatoria-aqui"

NODE_ENV="production"

# --- App Next.js ---

PORT=3000
HOSTNAME=0.0.0.0

# URL pública do site (opcional, útil para cookies em HTTPS)
# NEXT_PUBLIC_APP_URL="https://coach.seudominio.com"

# --- Deploy (EasyPanel) ---

# true APENAS no primeiro deploy (cria convites + conta demo). Depois mude para false.
RUN_SEED=false

# Reset único: preserva logins; apaga jornada + Prova/ProvaQuestao + corpus ENEM.
# USE SÓ UMA VEZ e REMOVA após o deploy — se ficar true, apagava tudo a cada redeploy.
# CONFIRMAR_RESET=true
# Com provas já no banco, o entrypoint bloqueia o reset (a menos que force):
# CONFIRMAR_RESET_FORCE=true
# SKIP_ENEM_SYNC=true

# Admin (reset e scripts/atualizar-admin.ts)
# ADMIN_EMAIL="fredmazzo@gmail.com"
# ADMIN_PASSWORD="sua-senha-admin"

# PDFs enviados por alunos (/listas/solicitar). No Docker, monte volume persistente em /app/data/uploads
# UPLOAD_STORAGE_DIR="/app/data/uploads"

# --- Reports / sugestões (beta) → N8N ---
# Webhook do N8N que recebe os reports de /reportar (opcional; sem isso, só grava no banco/admin).
# N8N_FEEDBACK_WEBHOOK_URL="https://infra-core-n8n-core.kxryyk.easypanel.host/webhook/coach-feedback"
# Opcional: segredo enviado no header X-Webhook-Secret para o N8N validar a origem.
# N8N_FEEDBACK_WEBHOOK_SECRET=""

# Lembretes do Ciclo de Aprendizagem: o N8N (Schedule diário) chama /api/cron/lembretes
# com o header x-cron-secret. Defina um segredo aleatório aqui e o mesmo no N8N.
# CRON_SECRET=""

# --- IA: classificação de provas (admin) + narrativa ---

OPENAI_API_KEY=""
# Modelo principal: pipeline PDF, reclassificar na auditoria e classificação legada
OPENAI_MODEL_PIPELINE="gpt-5.4-mini"
# Se gpt-5 falhar (500 intermitente), usa este. Se vazio com gpt-5, cai em gpt-4o-mini automaticamente.
OPENAI_MODEL_PIPELINE_FALLBACK="gpt-4o-mini"
# Retries HTTP por modelo antes de trocar (429/500/502/503)
OPENAI_RESPONSES_RETRIES=3
# Plano semanal + quests (substitui Gemini)
OPENAI_MODEL_COACH="gpt-5.5"
# Opcional: só extração de enunciados (fluxo legado); se vazio, usa PIPELINE
# OPENAI_MODEL_EXTRACAO="gpt-5.4-mini"
PIPELINE_V2_LOTE_SIZE=8
PIPELINE_V2_RETRIES_PRIMARY=2
PIPELINE_V2_RETRIES_FALLBACK=1
PIPELINE_V2_MIN_COVERAGE=0.55
# Legado (opcional; PIPELINE tem prioridade)
# OPENAI_MODEL_PASSO_2="gpt-5.4-mini"
# Lote e paralelismo (65 questões ≈ 17 lotes de 4, 4 paralelos)
CLASS_BATCH_SIZE=4
CLASSIFICACAO_PARALLEL=4
ENUNCIADO_PARA_CLASSIFICAR_MAX=4500
# Provas com inglês e espanhol na mesma numeração (ex. UFU): remove bloco «Língua Espanhola»
EXCLUIR_BLOCO_ESPANHOL=true

# =============================================================================
# Exemplo EasyPanel (ajuste com os dados do seu Postgres):
# =============================================================================
# DATABASE_URL=postgresql://postgres:abc123xyz@coach-vestibular-db:5432/coach_vestibular
# JWT_SECRET=8f3c2a1b9e7d4f6a0c5b2e8d1f4a7c0b3e6d9f2a5c8b1e4d7f0a3c6b9e2d5f8a1
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
# RUN_SEED=true

# =============================================================================
# Desenvolvimento local com SQLite (sem Docker):
# =============================================================================
# DATABASE_URL="file:./dev.db"
# JWT_SECRET="dev-local-secret"
# NODE_ENV=development
